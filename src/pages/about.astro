---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>About — Başar Örsel</title>
    <meta name="description" content="About Başar Örsel." />
  </head>
  <body>
    <main class="container">
      <header style="padding: var(--space-5) 0 var(--space-3);">
        <a href="/" style="font-size: 0.9rem;">← Back</a>
        <h1 style="margin: var(--space-2) 0 0;">About</h1>
      </header>

      <section style="padding: var(--space-2) 0;">
        <p>
          I'm Başar — a systems athlete and a WooCommerce operator based in İzmir,
          Türkiye. I split my time between building online stores for small
          businesses and training as a sprint orienteer.
        </p>
        <p>
          Formerly a national-level sprint orienteer, I'm working toward a return
          to the senior-elite national team. My training is data-driven: HRV, resting
          heart rate, and training stress balance guide every session.
        </p>
      </section>

      <footer class="muted" style="padding: var(--space-5) 0; font-size: 0.9rem;">
        © {new Date().getFullYear()} Başar Örsel
      </footer>
    </main>
  </body>
</html>
